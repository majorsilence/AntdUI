<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>..\Demo\icon.ico</ApplicationIcon>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\Demo\icon.ico" Link="icon.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AntdUI\AntdUI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Majorsilence.Forms" Version="26.0.32" />
    <PackageReference Include="Majorsilence.Forms.Avalonia" Version="26.0.32" />
  </ItemGroup>
</Project>