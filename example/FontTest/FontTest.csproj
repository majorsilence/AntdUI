<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AntdUI\AntdUI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Majorsilence.Forms" Version="26.0.32" />
    <PackageReference Include="Majorsilence.Forms.Avalonia" Version="26.0.32" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Majorsilence.Forms" />
    <Using Include="Majorsilence.Forms.Drawing" />
    <Using Include="System.Drawing" />
  </ItemGroup>
</Project>