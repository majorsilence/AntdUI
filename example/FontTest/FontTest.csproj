  <ItemGroup>
    <ProjectReference Include="../../../Majorsilence.Forms/src/Majorsilence.Forms/Majorsilence.Forms.csproj" />
    <ProjectReference Include="../../../Majorsilence.Forms/src/Majorsilence.Forms.Avalonia/Majorsilence.Forms.Avalonia.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Majorsilence.Forms" />
